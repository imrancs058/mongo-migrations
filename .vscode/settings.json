{
  "sqltools.connections": [
    {
      "database": "my_database",
      "driver": "PostgreSQL",
      "name": "vscode",
      "password": "postgres",
      "pgOptions": {
        "ssl": {}
      },
      "port": 5432,
      "previewLimit": 50,
      "server": "localhost",
      "username": "postgres"
    }
  ],
  "task.allowAutomaticTasks": true,
  "debug.openDebug": "neverOpen",
  "terminal.integrated.inheritEnv": false,
  "tasks": {
    "label": "lint on open",
    "type": "shell",
    "command": "npm run lint",
    "runOn": "folderOpen"
  }
}
